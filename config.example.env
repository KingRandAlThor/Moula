# Copie ce fichier en config.env et remplis-le. Ne le partage jamais.
ODDS_API_KEY=
TARGET_BOOK=Unibet (FR)
# "all" = tous les sports actifs (nécessite un plan payant), ou liste séparée par des virgules
SPORTS=soccer_france_ligue_one,soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_france_ligue_two,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_portugal_primeira_liga,soccer_netherlands_eredivisie
# Mission quotidienne : au moins un pari confirmé entre ces heures (heure de Paris), sinon "mort"
MISSION_FROM=12
MISSION_TO=14
MISSION_GRACE_MIN=10
INTERVAL_MIN=96
ACTIVE_FROM=0
ACTIVE_TO=24
MIN_EDGE=0.04

# Mail (Gmail : mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# SMS Free Mobile (option « Notifications par SMS » dans l'espace abonné)
FREE_USER=
FREE_PASS=

# Notification push gratuite : installe l'app ntfy et choisis un nom de topic secret
NTFY_TOPIC=

# Telegram (alertes + confirmation par boutons) : token via @BotFather, puis `python monitor.py chatid`
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

AF_KEY=
